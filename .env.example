# Trial page values. Copy to .env for local builds (.env is git-ignored).
# In CI these are GitHub repo Variables (Settings > Secrets and variables > Actions > Variables).
# EMPTY = that block or line is hidden. Malformed = the build fails.

# Proof
PROOF_STORES=
PROOF_UNITS_SOLD=
PROOF_REORDER_RATE=
PROOF_YEARS=
# Name|Area; Name|Area
PROOF_SHOPS=
# Real words from a real shop owner only. Needs PROOF_QUOTE_BY; the Spanish page also needs PROOF_QUOTE_ES.
PROOF_QUOTE=
PROOF_QUOTE_ES=
PROOF_QUOTE_BY=

# Suggested retail, e.g. 2.99 or 7.99–9.99
PRICE_MAGNET_RETAIL=
PRICE_STICKER_RETAIL=
PRICE_CAP_RETAIL=
PRICE_TOTE_RETAIL=
PRICE_COASTER_RETAIL=
MARGIN_FLOOR_PCT=
MARGIN_TOP_PCT=

# The box
BOX_MAGNETS=
BOX_STICKERS=
BOX_COASTERS=
BOX_CAPS=
BOX_TOTES=
BOX_VALUE_RETAIL=

# Timing and terms (TRIAL_REPLY_DAYS defaults to 2)
TRIAL_REPLY_DAYS=
TRIAL_SHIP_DAYS=
REORDER_DAYS=
TRIAL_REORDER_MIN=
CUSTOM_MIN=
CUSTOM_LEAD_DAYS=

# Florida ZIP range (defaults 32003-34997)
TRIAL_ZIP_MIN=
TRIAL_ZIP_MAX=

# GoatCounter site code; empty = no analytics script
GOATCOUNTER_CODE=
