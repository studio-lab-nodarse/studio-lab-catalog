{# Stroke icons + the heart mark for the trial page. #}
{% macro ico(name, cls) -%}
<svg class="ico{{ ' ' + cls if cls }}" viewBox="0 0 24 24" aria-hidden="true">
{%- if name == "wa" %}<path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.5-4.4a8.4 8.4 0 1 1 15.5-4.5z"/>
{%- elif name == "check" %}<path d="M5 12.5l4.5 4.5L19 7.5"/>
{%- elif name == "arrow" %}<path d="M4 12h15M13 6l6 6-6 6"/>
{%- elif name == "menu" %}<path d="M4 8h16M4 16h16"/>
{%- elif name == "close" %}<path d="M6 6l12 12M18 6 6 18"/>
{%- elif name == "plus" %}<path d="M12 5v14M5 12h14"/>
{%- elif name == "chat" %}<path d="M4 5h16v11H8l-4 4z"/>
{%- elif name == "eye" %}<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
{%- elif name == "qr" %}<rect x="3.5" y="3.5" width="6" height="6" rx="1"/><rect x="14.5" y="3.5" width="6" height="6" rx="1"/><rect x="3.5" y="14.5" width="6" height="6" rx="1"/><path d="M14.5 14.5h2.5v2.5M20.5 14.5v.01M17.5 20.5h3v-3"/>
{%- elif name == "alert" %}<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/>
{%- elif name == "pin" %}<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>
{%- elif name == "mail" %}<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.8 6.8 8.2 6.2 8.2-6.2"/>
{%- elif name == "spin" %}<path d="M12 3a9 9 0 1 1-9 9"/>
{%- endif %}</svg>
{%- endmacro %}

{% macro mark(w, h) -%}
<svg viewBox="-20 -20 507 471" width="{{ w }}" height="{{ h }}" aria-hidden="true"><path class="mk-o" d="M233.5 80 C 210 24, 160 3, 108 5 C 46 8, 5 52, 5 122 C 5 182, 42 232, 100 288 C 150 336, 205 384, 233.5 426 C 262 384, 317 336, 367 288 C 425 232, 462 182, 462 122 C 462 52, 421 8, 359 5 C 307 3, 257 24, 233.5 80 Z"/><path class="mk-f" transform="translate(230 200) rotate(-141) scale(1.65 2.02)" d="M0 -26 C -8 -50, -40 -60, -58 -40 C -74 -22, -64 8, -40 26 C -22 38, -4 44, 0 64 C 4 44, 22 38, 40 26 C 64 8, 74 -22, 58 -40 C 40 -60, 8 -50, 0 -26 Z"/></svg>
{%- endmacro %}

{% macro brand(href) -%}
<a class="brand" href="{{ href }}" aria-label="Miami Peculiar by Studio Lab">{{ mark(28, 26) }}<span class="disp">Miami Peculiar</span></a>
{%- endmacro %}
